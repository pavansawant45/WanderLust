<% const heroOn = typeof showHero !== "undefined" && showHero; %>
<header class="site-header">
  <nav class="navbar navbar-expand-lg" aria-label="Main">
    <div class="container">
      <a class="brand" href="/listings" aria-label="WanderLust, home">
        <svg class="brand-mark" width="28" height="28" viewBox="0 0 28 28" aria-hidden="true"><path d="M5 25V13a9 9 0 0 1 18 0v12z" fill="currentColor"/><circle cx="14" cy="13" r="3.2" fill="#F2A93B"/></svg>
        <span>WanderLust</span>
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Open menu">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="mainNav">
        <div class="nav-search">
          <% if (!heroOn) { %><%- include("search-form.ejs", { size: "sm" }) %><% } %>
        </div>
        <ul class="navbar-nav align-items-lg-center">
          <li class="nav-item"><a class="nav-link" href="/listings/new">List your place</a></li>
          <% if (!currUser) { %>
            <li class="nav-item"><a class="nav-link" href="/login">Log in</a></li>
            <li class="nav-item"><a class="btn btn-brand ms-lg-2" href="/signup">Sign up</a></li>
          <% } else { %>
            <li class="nav-item dropdown">
              <button class="avatar-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Account menu">
                <span class="avatar"><%= currUser.username.charAt(0).toUpperCase() %></span>
              </button>
              <ul class="dropdown-menu dropdown-menu-end">
                <li><h6 class="dropdown-header"><%= currUser.username %></h6></li>
                <li><a class="dropdown-item" href="/my-trips">My trips</a></li>
                <li><a class="dropdown-item" href="/host/bookings">Bookings on my listings</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="/logout">Log out</a></li>
              </ul>
            </li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>
</header>