<% layout("/layouts/boilerplate") %>
<%
  const parts = [];
  if (category) parts.push("category=" + encodeURIComponent(category));
  if (country) parts.push("country=" + encodeURIComponent(country));
  if (search) parts.push("search=" + encodeURIComponent(search));
  const backQs = parts.length ? "?" + parts.join("&") : "";
%>
<div class="d-flex justify-content-between align-items-center mt-3 mb-2">
    <h4 class="m-0">Listings map <small class="text-muted fs-6">(<%= pins.length %> shown)</small></h4>
    <a href="/listings<%= backQs %>" class="btn btn-dark btn-sm">Back to list</a>
</div>

<% if (pins.length === 0) { %>
    <p class="mt-4">No listings with a map location match your filters.</p>
<% } else { %>
    <div id="bigmap" class="map-box map-box-lg mb-5"></div>

    <script type="application/json" id="pin-data"><%- JSON.stringify(pins).replace(/</g, "\\u003c") %></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
    <script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script nonce="<%= nonce %>">
        (function () {
            const pins = JSON.parse(document.getElementById("pin-data").textContent);
            const map = L.map("bigmap");
            L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
                maxZoom: 19,
                referrerPolicy: "strict-origin-when-cross-origin",
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
            }).addTo(map);

            const bounds = [];
            pins.forEach((p) => {
                const box = document.createElement("div");
                const link = document.createElement("a");
                link.href = "/listings/" + p.id;
                link.textContent = p.title;
                const price = document.createElement("div");
                price.textContent = "₹" + Number(p.price).toLocaleString("en-IN") + " / night";
                box.append(link, price);

                L.marker([p.lat, p.lng]).addTo(map).bindPopup(box);
                bounds.push([p.lat, p.lng]);
            });
            map.fitBounds(bounds, { padding: [30, 30], maxZoom: 12 });
        })();
    </script>
<% } %>