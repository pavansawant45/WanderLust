<% layout("/layouts/boilerplate") %>
<div class="row mt-5 mb-5 text-center">
  <div class="col-8 offset-2">
    <h3>Redirecting to secure payment...</h3>
    <p>Please complete your payment for <b><%= listing.title %></b></p>
    <div class="spinner-border text-danger mt-3" role="status"></div>
  </div>
</div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
  const options = {
    key: "<%= keyId %>",
    amount: "<%= order.amount %>",
    currency: "<%= order.currency %>",
    name: "WanderLust",
    description: "<%= listing.title %> booking",
    order_id: "<%= order.id %>",
    theme: { color: "#fe424d" },
    handler: function (response) {
      fetch("/bookings/verify", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          razorpay_order_id: response.razorpay_order_id,
          razorpay_payment_id: response.razorpay_payment_id,
          razorpay_signature: response.razorpay_signature,
          bookingId: "<%= booking._id %>"
        })
      })
      .then(res => res.json())
      .then(data => {
        if(data.success) {
          window.location.href = data.redirectUrl;
        } else {
          window.location.href = "/bookings/cancel?bookingId=<%= booking._id %>";
        }
      })
      .catch(() => {
        window.location.href = "/bookings/cancel?bookingId=<%= booking._id %>";
      });
    },
    modal: {
      ondismiss: function () {
        window.location.href = "/bookings/cancel?bookingId=<%= booking._id %>";
      }
    }
  };

  const rzp = new Razorpay(options);
  rzp.open();
</script>