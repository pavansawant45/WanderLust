<% layout("/layouts/boilerplate") %>
<div class="row mt-3 mb-5">
  <div class="col-10 offset-1">
    <h3>Bookings on My Listings</h3>
    <% if(bookings.length === 0) { %>
      <p>No bookings yet on your listings.</p>
    <% } %>
    <table class="table mt-3">
      <thead>
        <tr><th>Listing</th><th>Guest</th><th>Dates</th><th>Total</th><th>Status</th></tr>
      </thead>
      <tbody>
        <% bookings.forEach(b => { %>
          <tr>
            <td><%= b.listing.title %></td>
            <td><%= b.guest.username %></td>
            <td><%= b.checkIn.toDateString() %> &rarr; <%= b.checkOut.toDateString() %></td>
            <td>&#8377;<%= b.totalPrice.toLocaleString("en-IN") %></td>
            <td><span class="badge bg-<%= b.status === 'confirmed' ? 'success' : b.status === 'cancelled' ? 'secondary' : 'warning' %>"><%= b.status %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>