<% layout("/layouts/boilerplate") %>
<div class="row mt-5 mb-5 text-center">
  <div class="col-8 offset-2">
    <i class="fa-solid fa-circle-check" style="font-size:3rem;color:#28a745;"></i>
    <h2 class="mt-3">Booking Confirmed!</h2>
    <p>Your stay at <b><%= booking.listing.title %></b> is booked from
      <%= booking.checkIn.toDateString() %> to <%= booking.checkOut.toDateString() %>.</p>
    <p>Total paid: &#8377;<%= booking.totalPrice.toLocaleString("en-IN") %></p>
    <a href="/my-trips" class="btn auth-btn mt-3">View My Trips</a>
  </div>
</div>